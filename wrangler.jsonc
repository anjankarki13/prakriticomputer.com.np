{
  // Cloudflare Workers configuration for prakriticomputer.com.np
  //
  // This site is static files only — there is no server-side code, so the
  // Worker just serves the assets. Cloudflare reads this file on every
  // deploy triggered by a push to GitHub.
  //
  // "name" must match the existing Worker exactly, or Cloudflare would
  // deploy to a different project.
  "name": "prakriti-computer-website",
  "compatibility_date": "2026-09-09",

  "assets": {
    // Serve everything from the repository root.
    "directory": "./",

    // html_handling is deliberately left at its default. Setting it to
    // "none" stops /services.html being redirected to /services, but it
    // also disables index.html resolution, which makes the site root
    // return a 404 — so the redirect is the lesser cost.

    // Serve our designed 404.html for unknown paths. Without this,
    // Cloudflare returns a 404 with a completely empty body — visitors
    // who mistype an address get a blank white page.
    "not_found_handling": "404-page"
  }
}
